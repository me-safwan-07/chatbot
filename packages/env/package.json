{
  "name": "@chatbot/env",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./compiled": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "esbuild src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/main.js",
  "main": "./dist/main.js",
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "@t3-oss/env-nextjs": "^0.13.11",
    "zod": "^4.4.3"
  }
}
